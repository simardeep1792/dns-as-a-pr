{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["apiVersion", "kind"],
  "properties": {
    "apiVersion": { "const": "kustomize.config.k8s.io/v1beta1" },
    "kind": { "const": "Kustomization" },
    "resources": {
      "type": "array",
      "items": { "type": "string" }
    },
    "patches": {
      "type": "array",
      "items": { "type": "object" }
    }
  }
}
