{
  "$schema": "http://json-schema.org/schema#",
  "title": "ClusterIssuer",
  "type": "object",
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": {"type": "string", "enum": ["cert-manager.io/v1"]},
    "kind": {"type": "string", "enum": ["ClusterIssuer"]},
    "metadata": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": {"type": "string"}
      },
      "additionalProperties": true
    },
    "spec": {
      "type": "object",
      "properties": {
        "acme": {"type": "object"}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
