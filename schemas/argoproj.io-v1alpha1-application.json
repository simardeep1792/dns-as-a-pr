{
  "$schema": "http://json-schema.org/schema#",
  "title": "Application",
  "type": "object",
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": {"type": "string", "enum": ["argoproj.io/v1alpha1"]},
    "kind": {"type": "string", "enum": ["Application"]},
    "metadata": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": {"type": "string"},
        "namespace": {"type": "string"}
      },
      "additionalProperties": true
    },
    "spec": {"type": "object"}
  },
  "additionalProperties": true
}
