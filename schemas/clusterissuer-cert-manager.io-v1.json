{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": { "const": "cert-manager.io/v1" },
    "kind": { "const": "ClusterIssuer" },
    "metadata": { "type": "object" },
    "spec": {
      "type": "object",
      "required": ["acme"],
      "properties": {
        "acme": {
          "type": "object",
          "required": ["email", "server", "privateKeySecretRef", "solvers"],
          "properties": {
            "email": { "type": "string", "minLength": 1 },
            "server": { "type": "string", "minLength": 1 },
            "privateKeySecretRef": {
              "type": "object",
              "required": ["name"],
              "properties": {
                "name": { "type": "string", "minLength": 1 }
              }
            },
            "solvers": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "object" }
            }
          }
        }
      }
    }
  }
}
